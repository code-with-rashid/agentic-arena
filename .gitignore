Thumbs.db

# Obsidian: share portable link settings, keep personal state local
knowledge/.obsidian/*
!knowledge/.obsidian/app.json
knowledge/.trash/
knowledge/personal/*
!knowledge/personal/README.md

# Arena run artifacts (raw traces are large; scorecards under results/ ARE committed)
runs/
results/**/raw/
results/**/*.tmp

# MkDocs build output (`mkdocs build` / `mkdocs serve`)
site/

# Framework checkpoint stores. The harness puts these under runs/checkpoints/,
# but an adapter built outside a run must never leave one in the working tree.
*.sqlite
*.sqlite3
