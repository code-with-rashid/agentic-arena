# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
!docs/build/
!docs/build/**
dist/
.venv/
venv/
env/
.python-version

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.idea/
.vscode/
