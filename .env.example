# Copy to .env for local live runs.  Mock mode needs none of this.

# mock | live
ARENA_LLM_MODE=mock

# The single model every adapter must use. Pick one OpenAI-compatible model id.
ARENA_MODEL=gpt-4.1-mini

# OpenAI-compatible gateway. In live mode this points at a real provider; in mock
# mode the harness starts its own server and overrides this automatically.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-replace-me

# Per-1M-token prices (USD) used only for the cost column of the scorecard.
ARENA_PRICE_INPUT_PER_M=0.40
ARENA_PRICE_OUTPUT_PER_M=1.60
